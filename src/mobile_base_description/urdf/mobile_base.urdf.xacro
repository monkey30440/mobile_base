<?xml version="1.0"?>
<!--
  SUB-012 Robot Description — mobile_base 頂層描述。

  規格見 docs/05_subsystem.md § SUB-012 Robot Description。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_base">

  <!-- 是否宣告 ros2_control 硬體介面。
       僅檢視 TF／幾何時可設為 false，避免 controller_manager 嘗試載入插件。 -->
  <xacro:arg name="use_ros2_control" default="true"/>
  <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>

  <xacro:include filename="$(find mobile_base_description)/urdf/base.urdf.xacro"/>
  <xacro:include filename="$(find mobile_base_description)/urdf/base_control.ros2_control.xacro"/>

  <xacro:if value="$(arg use_ros2_control)">
    <xacro:base_control_ros2_control serial_port="$(arg serial_port)"/>
  </xacro:if>

</robot>
