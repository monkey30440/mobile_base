<?xml version="1.0"?>
<!--
  mobile_base 車體描述。

  來源：ref/FIH_AMR_ROBOT_V2.0_0731（完整人形 AMR，84 links）。
  本檔僅保留 mobile_base v0.1 所需之 24 links：
  車體、驅動輪 ×2 與懸吊、caster ×4、感測器 frame。
  軀幹、雙臂、雙手、頭部不納入。

  既有 link 與 joint 名稱一律沿用來源 URDF，不予改動。
  base_footprint 為新增連桿（來源未定義），為導航與定位之地面基準。

  被動關節（caster ×16、懸吊 prismatic ×2）改為 fixed：
  該等關節無編碼器，無任何 joint state 來源，
  保留為可動將使 TF tree 殘缺並持續產生 tf2 警告。
  v0.1 不需建模懸吊行程與 caster 轉向；
  日後若需精確視覺化，可還原型別並另行提供 joint state。
  僅驅動輪 driving_wheel_joint_L / _R 維持 continuous，
  由 joint_state_broadcaster 提供狀態。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_base">

  <!-- 地面基準：驅動輪中心位於 base_link 下方 0.176 m，輪半徑 0.08 m -->
  <xacro:property name="base_link_height" value="0.256"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 ${base_link_height}" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.020088 -0.00015211 -0.11461" rpy="0 0 0" />
      <mass value="54.0" />
      <inertia ixx="0.60173728" ixy="0.0093494997" ixz="0.00060931233" iyy="0.50814137" iyz="2.8622951E-06" izz="1.0391101" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mobile_base_description/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mobile_base_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>
