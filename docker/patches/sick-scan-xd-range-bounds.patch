+// LaserScan uses float32 measurement bounds. An unset pair preserves upstream behavior.
+static bool validLaserScanRanges(double minimum, double maximum)
+{
+    const bool valid = (minimum == 0 && maximum == 0) ||
+        (std::isfinite(minimum) && std::isfinite(maximum) && minimum >= 0 &&
+         maximum > minimum && maximum <= std::numeric_limits<float>::max());
+    if (!valid)
+        ROS_ERROR_STREAM("Invalid laserscan_range_min/max: use 0/0 to disable or finite 0 <= min < max");
+    return valid;
+}
